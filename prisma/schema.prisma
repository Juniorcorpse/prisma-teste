generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  status Boolean @default(true)
  name  String
  email String @unique
  senha String

  // Amarra o usuário a um tenant
  tenantId  String
}
